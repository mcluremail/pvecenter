#!/usr/bin/make -f

export PYBUILD_NAME=virtdeck
export PYBUILD_SYSTEM=pyproject

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# tests not yet available

override_dh_install:
	dh_install
	# install desktop file
	install -D -m 644 debian/virtdeck.desktop \
		$(CURDIR)/debian/virtdeck/usr/share/applications/virtdeck.desktop
